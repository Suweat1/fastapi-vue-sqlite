      "text": "conversations 会话表\nPK  id                   INTEGER\nFK  item_id              INTEGER > items.id\nFK  buyer_id             INTEGER > users.id\nFK  seller_id            INTEGER > users.id\nUQ  「item_id, buyer_id, seller_id」\n    last_message_preview VARCHAR「255」\n    last_message_at      DATETIME\n    unread_buyer_count   INTEGER 默认 0\n    unread_seller_count  INTEGER 默认 0\n    created_at           DATETIME\n    updated_at           DATETIME",
