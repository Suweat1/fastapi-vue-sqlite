      "containerId": "table-items",
      "originalText": "items 商品表\nPK  id           INTEGER\n    title        VARCHAR「120」\n    description  TEXT\n    price        NUMERIC「10,2」CHECK>=0\n    condition    VARCHAR「30」默认 九成新\n    location     VARCHAR「120」默认 校园\n    status       VARCHAR「20」默认 active\n    views        INTEGER 默认 0\n    is_featured  BOOLEAN 默认 0\nFK  seller_id    INTEGER > users.id CASCADE\nFK  category_id  INTEGER > categories.id RESTRICT\n    created_at   DATETIME\n    updated_at   DATETIME",
      "autoResize": true,
      "lineHeight": 1.25
